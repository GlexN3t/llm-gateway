# Copy to .env and fill in. NEVER commit real keys.
# Demo-mode tenant (only seeded when ASPNETCORE_ENVIRONMENT=Development):
Tenancy__DevApiKey=change-me-to-a-long-random-string

# Upstream provider keys (leave empty to disable that provider):
Providers__OpenAI__ApiKey=
Providers__Anthropic__ApiKey=
Providers__Ollama__BaseUrl=http://host.containers.internal:11434

# Optional tuning:
# Storage__ConnectionString=Data Source=/data/gateway.db
# Caching__TtlSeconds=300
# Caching__SizeLimit=1024
