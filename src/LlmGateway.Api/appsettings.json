{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Routing": [
      { "Pattern": "gpt-*", "Provider": "openai" },
      { "Pattern": "o3*", "Provider": "openai" },
      { "Pattern": "o4*", "Provider": "openai" },
      { "Pattern": "claude-*", "Provider": "anthropic" },
      { "Pattern": "llama*", "Provider": "ollama" },
      { "Pattern": "qwen*", "Provider": "ollama" },
      { "Pattern": "*", "Provider": "fake" }
    ],
    "Models": [
      { "Id": "gpt-4o", "Provider": "openai", "DisplayName": "GPT-4o" },
      { "Id": "gpt-4o-mini", "Provider": "openai", "DisplayName": "GPT-4o mini" },
      { "Id": "claude-sonnet-4-5", "Provider": "anthropic", "DisplayName": "Claude Sonnet 4.5" },
      { "Id": "claude-haiku-4-5", "Provider": "anthropic", "DisplayName": "Claude Haiku 4.5" },
      { "Id": "llama3.2", "Provider": "ollama", "DisplayName": "Llama 3.2" },
      { "Id": "qwen2.5", "Provider": "ollama", "DisplayName": "Qwen 2.5" }
    ]
  },
  "Providers": {
    "OpenAI": {
      "BaseUrl": "https://api.openai.com",
      "ApiKey": "",
      "TimeoutSeconds": 60,
      "MaxAttempts": 3
    },
    "Anthropic": {
      "BaseUrl": "https://api.anthropic.com",
      "ApiKey": "",
      "TimeoutSeconds": 60,
      "MaxAttempts": 3
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 120,
      "MaxAttempts": 2
    }
  },
  "Storage": {
    "ConnectionString": "Data Source=data/gateway.db"
  },
  "Caching": {
    "TtlSeconds": 300,
    "SizeLimit": 1024
  },
  "RateLimit": {
    "PermitPerMinute": 60,
    "QueueLimit": 0
  },
  "Pricing": {
    "gpt-4o-mini": { "InputPerMillion": 0.15, "OutputPerMillion": 0.6 },
    "gpt-4o": { "InputPerMillion": 2.5, "OutputPerMillion": 10 },
    "claude-sonnet-4-5": { "InputPerMillion": 3, "OutputPerMillion": 15 },
    "claude-haiku-4-5": { "InputPerMillion": 1, "OutputPerMillion": 5 },
    "*": { "InputPerMillion": 0, "OutputPerMillion": 0 }
  },
  "Tenancy": {
    "DevTenantId": "dev",
    "DevTenantName": "Development Tenant",
    "DevApiKey": ""
  }
}
